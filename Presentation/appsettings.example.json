{
    // Standard .NET logging configuration - controls how chatty each category is in bot.log / the console.
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "System": "Information",
            "Microsoft": "Information"
        }
    },

    // Connection settings for F-Chat, F-List's chat protocol. This is how the bot logs in and talks.
    // Do NOT commit real values for Account/Password/AutoJoinChannelCode - keep this file scrubbed
    // and fill your own in locally (or override via user secrets / environment variables in production).
    "FChat": {
        // Public F-Chat WebSocket endpoint - no need to change this.
        "WebSocketUrl": "wss://chat.f-list.net/chat2",

        // Sent as the client's user agent when talking to F-List. Describes what the bot is for.
        "UserAgent": "YOUR_BOT_USER_AGENT",

        // The F-List account the bot logs in as. Create a dedicated bot account on f-list.net
        // and put its account name here.
        "Account": "YOUR_FLIST_ACCOUNT_NAME",

        // The password for the account above. Get this from the bot's F-List account settings -
        // never a real password in source control.
        "Password": "YOUR_FLIST_ACCOUNT_PASSWORD",

        // The channel the bot auto-joins on startup, identified by its channel code (the
        // "adh-..." style id, not its display name). Find this in the channel's info panel in
        // F-Chat, or from the URL when opening the channel on the F-List website.
        "AutoJoinChannelCode": "YOUR_CHANNEL_CODE",

        // The F-List character the bot appears as in chat.
        "Character": "YOUR_BOT_CHARACTER_NAME",

        // Bot version string, reported wherever the bot identifies itself.
        "Version": "YOUR_BOT_VERSION",

        // F-List's ticket endpoint used to authenticate before opening the WebSocket - no need to change this.
        "TicketEndpoint": "https://www.f-list.net/json/getApiTicket.php"
    }
}
